{
  "name": "smartme",
  "version": "0.1.0",
  "private": true,
  "description": "SmartMe — Indian microlearning and personal development platform (MVP monorepo)",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @smartme/backend --filter @smartme/admin dev",
    "dev:backend": "pnpm --filter @smartme/backend dev",
    "dev:admin": "pnpm --filter @smartme/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f postgres",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @smartme/backend prisma:migrate",
    "db:seed": "pnpm --filter @smartme/backend db:seed",
    "content:verify": "pnpm --filter @smartme/backend content:verify",
    "db:studio": "pnpm --filter @smartme/backend prisma:studio",
    "prisma:generate": "pnpm --filter @smartme/backend prisma:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
