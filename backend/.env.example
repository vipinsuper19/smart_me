# Runtime
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Set true only when the API is behind a trusted reverse proxy
TRUST_PROXY=false

# PostgreSQL (matches infra/docker-compose.yml; host port 5433 avoids conflicts)
DATABASE_URL=postgresql://smartme:smartme@localhost:5433/smartme?schema=public

# Daily boundaries, streaks and challenge dates use this time zone
APP_TIME_ZONE=Asia/Kolkata

# PostgreSQL pool size for the Prisma driver adapter
DATABASE_POOL_MAX=10

# Authentication — replace with strong random values (>= 32 chars) in every environment
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=smartme-api
JWT_AUDIENCE=smartme-api

# Google Sign-In (enable after configuring OAuth client IDs)
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=

# Consent and account deletion
TERMS_VERSION=2026-10-21
ACCOUNT_DELETION_GRACE_DAYS=30

# Feature flags
BILLING_ENABLED=false

# Billing provider: `mock` for local development, `google_play` for store builds
BILLING_PROVIDER=mock
BILLING_GRACE_PERIOD_DAYS=3

# Google Play (required when BILLING_ENABLED=true and BILLING_PROVIDER=google_play)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Shared secret configured on the Pub/Sub push subscription (>= 16 chars)
GOOGLE_PLAY_RTDN_SECRET=

# Notifications (FCM). Preferences and device routes work regardless of this flag.
NOTIFICATIONS_ENABLED=false
# `mock` logs deliveries instead of calling FCM; production must use `fcm`
NOTIFICATIONS_PROVIDER=mock
NOTIFICATIONS_SCHEDULER_ENABLED=false
NOTIFICATIONS_INTERVAL_SECONDS=300
NOTIFICATIONS_MAX_PER_DAY=2

# Firebase Cloud Messaging (required when NOTIFICATIONS_ENABLED=true and NOTIFICATIONS_PROVIDER=fcm)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Development seed credentials (never use these in production)
SEED_ADMIN_EMAIL=admin@smartme.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_LEARNER_EMAIL=learner@smartme.local
SEED_LEARNER_PASSWORD=Learner@12345
