<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) cloud backup and device transfer rules.
    Session tokens are encrypted with a device-bound Keystore key, so they are
    excluded from both channels; the user signs in again on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/smartme_tokens.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/smartme_tokens.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
