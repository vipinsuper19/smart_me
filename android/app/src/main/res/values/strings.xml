    <string name="purchase_success_action">Start learning</string>
    <string name="purchase_pending_title">Payment pending</string>
    <string name="purchase_pending_body">Google Play is still processing your payment. Premium unlocks automatically once the payment completes.</string>
    <string name="purchase_pending_note">You can keep using the free lessons while you wait. We never show premium access before the server verifies it.</string>
    <string name="purchase_pending_action">Got it</string>
    <string name="purchase_failure_title">Purchase not completed</string>
    <string name="purchase_failure_body">We couldn\'t complete your purchase. You haven\'t been charged for premium access.</string>
    <string name="purchase_failure_action">Try again</string>
    <string name="purchase_failure_dismiss">Not now</string>
    <string name="purchase_verified_note">Premium access is verified by SmartMe before it is unlocked.</string>

    <!-- Help and support -->
    <string name="support_title">Help and support</string>
    <string name="support_intro_title">How can we help?</string>
    <string name="support_intro_body">Find quick answers below, or email us and a real person will take a look.</string>
    <string name="support_contact_title">Contact support</string>
    <string name="support_contact_body">Write to %1$s from the email address on your SmartMe account so we can find your progress.</string>
    <string name="support_email_action">Email support</string>
    <string name="support_report_action">Report a problem</string>
    <string name="support_response_note">We aim to reply within two working days.</string>
    <string name="support_no_email_app">No email app is set up on this device. Write to support@smartme.app from any email account.</string>
    <string name="support_email_subject">SmartMe support</string>
    <string name="support_report_subject">SmartMe problem report</string>
    <string name="support_faq_title">Frequently asked questions</string>
    <string name="support_privacy_hint">You can review or delete your data from Privacy and account deletion in your profile.</string>
    <string name="support_faq_offline_q">Can I learn without internet?</string>
    <string name="support_faq_offline_a">You need a connection to load lessons for the first time. If your connection drops mid-lesson, anything already saved stays on your account; reopen the lesson to continue where you left off.</string>
    <string name="support_faq_progress_q">My progress or XP looks wrong.</string>
    <string name="support_faq_progress_a">Progress is calculated on our servers from completed lessons and quizzes. Reopen the Progress tab to refresh. If a completed lesson still doesn\'t appear, email us with the lesson title and roughly when you finished it.</string>
    <string name="support_faq_premium_q">What does Premium include?</string>
    <string name="support_faq_premium_a">Premium unlocks the full course library, premium learning paths, additional practice and expanded audio access. The Subscription screen lists the benefits for each plan.</string>
    <string name="support_faq_cancel_q">How do I cancel Premium?</string>
    <string name="support_faq_cancel_a">Open Google Play, go to Payments and subscriptions, then Subscriptions. Choose SmartMe Premium and cancel. Access continues until the end of the paid period.</string>
    <string name="support_faq_restore_q">I reinstalled the app and lost Premium.</string>
    <string name="support_faq_restore_a">Sign in with the same account you used to buy Premium, open SmartMe Premium from your profile and tap Restore purchases.</string>
    <string name="support_faq_delete_q">Can I delete my account?</string>
    <string name="support_faq_delete_a">Yes. Open Privacy and account deletion from your profile. Deletion is scheduled after a short grace period, and signing in again before then cancels the request.</string>
    <string name="support_faq_notifications_q">How do I stop reminders?</string>
    <string name="support_faq_notifications_a">Open Notification settings from your profile and turn off the reminders you don\'t want. Reminder times use your account time zone.</string>

    <!-- Privacy and account deletion -->
    <string name="privacy_title">Privacy and account deletion</string>
    <string name="privacy_intro_title">Your data, your choice</string>
    <string name="privacy_intro_body">This page explains what SmartMe stores, why we store it and how to delete your account. No surprises.</string>
    <string name="privacy_data_title">What we store</string>
    <string name="privacy_data_body">Your account details such as email and the profile information you add, learning activity such as lesson progress, quiz attempts, XP and streaks, and settings such as your time zone and reminder preferences.</string>
    <string name="privacy_use_title">How we use it</string>
    <string name="privacy_use_body">To run your account, personalise lessons and reminders, show your progress, and keep premium access accurate. We do not sell your personal data.</string>
    <string name="privacy_retention_title">How long we keep it</string>
    <string name="privacy_retention_body">Active accounts keep their learning history so progress stays intact. When you request deletion, your account is scheduled for deletion after a short grace period, and you can cancel the request by signing in before then.</string>
    <string name="privacy_delete_title">Delete your account</string>
    <string name="privacy_delete_body">Requesting deletion signs you out on this device and schedules your account and learning data for permanent deletion. This cannot be undone once the grace period ends.</string>
    <string name="privacy_delete_action">Request account deletion</string>
    <string name="privacy_delete_confirm_title">Delete your account?</string>
    <string name="privacy_delete_confirm_body">Your sessions will be revoked immediately and your account will be deleted after the grace period. You can add an optional reason below, then confirm.</string>
    <string name="privacy_delete_reason_label">Reason (optional)</string>
    <string name="privacy_delete_confirm_action">Request deletion</string>
    <string name="privacy_delete_cancel">Keep my account</string>
    <string name="privacy_requested_title">Deletion scheduled</string>
    <string name="privacy_requested_body">Your request was received and you\'ve been signed out on this device. Sign in again before %1$s to cancel it.</string>
    <string name="privacy_requested_body_unknown">Your request was received and you\'ve been signed out on this device. Sign in again before the grace period ends to cancel it.</string>
    <string name="privacy_requested_action">Sign out</string>
    <string name="privacy_pending_title">Deletion is scheduled</string>
    <string name="privacy_pending_body">Requested on %1$s. Your account is scheduled for deletion on %2$s.</string>
    <string name="privacy_pending_body_unknown">Your account is scheduled for deletion after the grace period.</string>
    <string name="privacy_pending_cancel_action">Cancel deletion request</string>
    <string name="privacy_pending_cancelling">Cancelling…</string>
    <string name="privacy_cancel_success">Your deletion request was cancelled. Your account stays active.</string>
    <string name="privacy_load_error_title">We couldn\'t load your deletion status</string>
    <string name="privacy_contact_hint">Questions about privacy? Contact support from your profile.</string>
</resources>
