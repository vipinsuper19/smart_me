<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty drawable for the Android 12+ system splash icon.

  The in-app splash already draws the brand mark, and letting the platform show
  its own copy makes two different-sized logos cross-fade on cold start. A
  transparent icon leaves only the background, so the branded splash is the
  single thing the learner sees.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
